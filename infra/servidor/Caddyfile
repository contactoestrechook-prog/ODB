# Proxy de ODB: candado HTTPS automático (Let's Encrypt) y cabeceras de seguridad.
(seguridad) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	encode zstd gzip
}

{$HOST_API} {
	import seguridad
	reverse_proxy api:3001
}
{$HOST_PANEL} {
	import seguridad
	reverse_proxy admin:3000
}
{$HOST_TIENDA} {
	import seguridad
	reverse_proxy web:3000
}
{$HOST_WAHA} {
	import seguridad
	reverse_proxy waha:3000
}
# La línea general corre en su propio WAHA (motor GOWS). Se abre igual que el otro,
# con la misma clave, para que la app RESPONDE del celular pueda mandar por ella (5/11/2026).
{$HOST_WAHA_GOWS:wag.172-233-20-11.sslip.io} {
	import seguridad
	reverse_proxy waha-gows:3000
}
