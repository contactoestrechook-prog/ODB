SUPABASE_URL=...
# Clave pública (solo lectura: carta, validar mesa). Para escrituras (admin),
# pegar la service_role key: dashboard de Supabase -> Settings -> API keys -> service_role
SUPABASE_KEY=...
SUPABASE_SERVICE_KEY=...
PUERTO=3002
# Clave simple para el panel de Damián (Fase 1: un solo usuario, sin JWT todavía).
# Se manda como header "x-admin-key" desde apps/gastro-admin.
ADMIN_KEY=...
# IA: redacta el borrador de respuesta a reseñas de Google (revisión humana antes de publicar)
ANTHROPIC_API_KEY=...
# Google Business Profile: de dónde salen las reseñas y a dónde se publica la
# respuesta. Requiere que Damián autorice el acceso (OAuth) — hasta entonces,
# las reseñas se cargan a mano o por un import manual, y "publicar" queda pendiente.
# GOOGLE_BUSINESS_ACCOUNT_ID=...
# GOOGLE_BUSINESS_LOCATION_ID=...
# GOOGLE_OAUTH_REFRESH_TOKEN=...
# Link directo a "dejar una reseña" (Google) — se muestra al cliente contento.
# Se arma con el Place ID de Gran Caminito: https://search.google.com/local/writereview?placeid=...
GOOGLE_REVIEW_LINK=...
# WhatsApp Business Cloud API: alerta al encargado cuando un cliente está molesto.
# Falta de alta en Meta — hasta entonces, la alerta queda registrada en la tabla
# `alertas_encargado` y visible en el panel, pero no se envía el mensaje real.
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...
# WHATSAPP_ENCARGADO_NUMERO=...
CORS_ORIGINS=http://localhost:3010,http://localhost:3011
